{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "outDir": "dist"
  },
  "include": ["./hardhat.config.ts", "./examples/**/*.ts", "./scripts/**/*.ts", "./src/**/*.ts", "./test/**/*.ts", "./typechain-types/**/*.ts"]
}
