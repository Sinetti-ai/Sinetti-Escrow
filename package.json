{
  "name": "sinetti",
  "version": "0.2.0",
  "description": "Experimental open-source protocol for verifiable digital work: escrow contracts, deterministic verification, and challenge/arbitration tooling.",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://sinetti.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinetti-ai/Sinetti-Escrow.git"
  },
  "bugs": {
    "url": "https://github.com/Sinetti-ai/Sinetti-Escrow/issues"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "npm run test:forge && npm run test:hardhat",
    "test:forge": "bash scripts/forge.sh test",
    "test:hardhat": "hardhat test",
    "evidence:hash": "ts-node scripts/evidence-hash.ts",
    "verifier": "ts-node scripts/verify.ts",
    "arbitrator": "ts-node scripts/arbitrate.ts",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "audit:dependencies": "npm audit --package-lock-only --omit=dev --audit-level=high",
    "example": "hardhat run examples/full-lifecycle.ts",
    "example:dispute": "hardhat run examples/dispute.ts",
    "example:timeout": "hardhat run examples/timeout-refund.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "typecheck": "tsc --noEmit -p tsconfig.examples.json",
    "validate:schemas": "sh -c 'for s in schemas/*.schema.json; do n=$(basename $s .schema.json); npx ajv validate --spec=draft2020 --validate-formats=false -s $s -d schemas/examples/$n.example.json || exit 1; done; npx ajv validate --spec=draft2020 --validate-formats=false -s schemas/customer-export.schema.json -d examples/delivery/customer-export.json'"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "ajv": "8.20.0",
    "ajv-cli": "^5.0.0",
    "chai": "^6.2.2",
    "ethers": "^6.14.0",
    "hardhat": "^3.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-uri": "3.1.7"
  }
}
